{
  "name": "ap-note-pad",
  "productName": "AP Note Pad",
  "version": "0.3.7",
  "description": "AP Note Pad - Windows 11 desktop sticky-notes app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . \"AP Note Pad\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=demo-desktop.png --ignore=dist --ignore=\"selftest\\\\.js$\" --ignore=\"^/docs\" --ignore=\"^/\\\\.github\" --ignore=\"^/tests\" --ignore=\"^/scripts\" --ignore=\"installer\\\\.nsi$\" --ignore=\"^/CHANGELOG\\\\.md$\" --ignore=\"^/CONTRIBUTING\\\\.md$\""
